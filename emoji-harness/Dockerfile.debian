FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends sway grim dbus-daemon dbus-bin mesa-vulkan-drivers libvulkan1 libpipewire-0.3-0t64 libxkbcommon0 fonts-dejavu-core fonts-liberation fonts-noto-core fonts-noto-color-emoji libnotify-bin libglib2.0-bin python3 fontconfig && rm -rf /var/lib/apt/lists/*
ENV XDG_CURRENT_DESKTOP=sway
