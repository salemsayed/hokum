FROM hokum-emoji/builder
RUN apt-get update && apt-get install -y --no-install-recommends sway grim dbus-daemon dbus-bin mesa-vulkan-drivers libvulkan1 fonts-noto-core fonts-noto-color-emoji libnotify-bin libglib2.0-bin python3 python3-pil fontconfig adwaita-icon-theme && rm -rf /var/lib/apt/lists/*
