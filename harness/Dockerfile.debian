# Debian 13 with Cinnamon-style setup (Linux Mint): no icon settings files, Web Apps made by webapp-manager.
FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates sway grim dbus-daemon dbus-bin mesa-vulkan-drivers libvulkan1 \
    libpipewire-0.3-0t64 libxkbcommon0 fonts-noto-core fonts-noto-color-emoji libnotify-bin libglib2.0-bin python3 adwaita-icon-theme chromium \
 && rm -rf /var/lib/apt/lists/*
COPY . /harness
RUN sh /harness/fixtures.sh mint chromium
ENV XDG_CURRENT_DESKTOP=X-Cinnamon \
    SCENARIO_ENV='{"browser": 1, "browser_app": "Chromium", "browser_desktop": "chromium"}'
