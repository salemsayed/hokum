# Ubuntu 24.04, GNOME-style: Yaru-purple set in GSettings and read through the settings portal.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl sway grim dbus-daemon dbus-bin mesa-vulkan-drivers libvulkan1 \
    libpipewire-0.3-0t64 libxkbcommon0 fonts-noto-core fonts-noto-color-emoji libnotify-bin libglib2.0-bin python3 \
    yaru-theme-icon adwaita-icon-theme gnome-calculator xdg-desktop-portal xdg-desktop-portal-gtk dconf-cli dconf-gsettings-backend dconf-service gsettings-desktop-schemas \
 && curl -fsSLo /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb && apt-get install -y --no-install-recommends /tmp/chrome.deb \
 && rm -rf /var/lib/apt/lists/* /tmp/chrome.deb
COPY . /harness
RUN sh /harness/fixtures.sh app google-chrome \
 && mkdir -p /root/.config/xdg-desktop-portal && printf '[preferred]\ndefault=gtk\n' > /root/.config/xdg-desktop-portal/portals.conf \
 && dbus-run-session -- gsettings set org.gnome.desktop.interface icon-theme 'Yaru-purple'
ENV XDG_CURRENT_DESKTOP=ubuntu:GNOME PORTAL=1 \
    SCENARIO_ENV='{"browser": 1, "browser_app": "Google Chrome", "browser_desktop": "google-chrome", "calculator": 1}'
