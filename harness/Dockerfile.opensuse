# openSUSE Tumbleweed, KDE Plasma-style: Breeze from kdeglobals, KDE apps.
FROM opensuse/tumbleweed
RUN zypper -n install --no-recommends sway grim dbus-1 dbus-1-daemon Mesa-vulkan-device-select libvulkan_lvp libpipewire-0_3-0 libxkbcommon0 \
    google-noto-sans-fonts google-noto-coloremoji-fonts google-noto-sans-arabic-fonts libnotify-tools glib2-tools python3 kf6-breeze-icons dolphin konsole \
 ; rc=$?; [ $rc = 0 ] || [ $rc = 107 ]; zypper clean -a
COPY . /harness
RUN sh /harness/fixtures.sh none && printf '[Icons]\nTheme=breeze\n' > /root/.config/kdeglobals
ENV XDG_CURRENT_DESKTOP=KDE SCENARIO_ENV='{"kde": 1}'
